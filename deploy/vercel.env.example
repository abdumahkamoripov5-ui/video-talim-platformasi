# Vercel -> Settings -> Environment Variables (Production only)
DEBUG=False
SECRET_KEY=generate-a-new-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ALLOWED_HOSTS=video-talim-platformasi.vercel.app
FRONTEND_URL=https://video-talim-platformasi.vercel.app
CORS_ALLOWED_ORIGINS=https://video-talim-platformasi.vercel.app
RUN_MIGRATIONS=true
VITE_API_URL=/api
# VERCEL, VERCEL_URL and VERCEL_ENV are provided by Vercel. Do not add them.

# Private Neon Object Storage (enable only after all values are configured)
OBJECT_STORAGE_ENABLED=False
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
MEDIA_BUCKET=edu-media
