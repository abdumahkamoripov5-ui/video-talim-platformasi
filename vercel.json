{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "django",
      "buildCommand": "python scripts/vercel_build.py"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend",
        "path": "/django"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "backend",
        "path": "/django"
      }
    },
    {
      "source": "/static/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/media/:path*",
      "destination": {
        "service": "backend",
        "path": "/django"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
